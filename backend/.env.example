# 백엔드 설정 예시예요. 이 파일을 .env 로 복사해서 값을 채워 주세요. (.env는 커밋하지 않아요)

# DB 주소. 기본은 backend/data/app.db (SQLite). PostgreSQL로 바꿀 때는 주소만 바꾸면 돼요.
DATABASE_URL=sqlite:///./data/app.db

# JWT 서명 비밀키. 비워 두면 개발용 기본값을 써요 (운영에서는 꼭 긴 임의 문자열로 채워야 해요).
JWT_SECRET=

# dev 이면 개발용 로그인(/api/v1/auth/dev-login)이 켜지고, 시작할 때 테이블이 없으면 만들어요.
APP_ENV=dev

# 카카오 로컬 검색 REST API 키. 비워 두면 장소 검색은 502(UPSTREAM_ERROR)로 응답해요.
KAKAO_REST_API_KEY=

# 캠퍼스 중심 좌표 (OSM 기준 정문 35.7003,128.4576 과 강의동 35.7063,128.4538 의 중간점 — 팀과 최종 확인 필요)와 서비스 반경(m)
CAMPUS_LAT=35.7033
CAMPUS_LNG=128.4557
SERVICE_RADIUS_M=8000

# 허용할 프론트 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:5173
