# ---- backend (backend/.env 로 복사해서 사용) ----
DATABASE_URL=sqlite:///./data/app.db
BUS_SOURCE=crawl         # crawl(대구 버스정보시스템) | mock | api
BUS_API_KEY=
SEMINAR_SOURCE=portal    # portal(학생포탈 세미나 공지) | mock
PORTAL_COOKIE_FILE=data/portal_cookies.json
SEMINAR_POLL_MINUTES=10  # 07~23시 변경 감지 주기
SEMINAR_FULL_PAGES=3     # 매일 05시 다시 확인할 최근 페이지 수
ADMIN_TOKEN=             # 관리자 API 토큰 (python -c "import secrets;print(secrets.token_urlsafe(24))")
DISCORD_WEBHOOK_URL=     # 포탈 로그인 만료 알림 (선택)
JWT_SECRET=
ALLOWED_EMAIL_DOMAIN=dgist.ac.kr
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
CORS_ORIGINS=http://localhost:5173

# ---- frontend (frontend/.env 로 복사해서 사용) ----
# 비우면 OpenFreeMap(키 불필요) 사용
VITE_MAP_STYLE_URL=
